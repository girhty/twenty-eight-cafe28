---
const contactInfo = {
  address: 'سنتر المجمع، مجمع, Baghdad, 00964',
  phone: '0771 710 7107',
  hours: {
    weekdays: '8:00 AM – 12:00 AM',
    weekends: '9:00 AM – 1:00 AM',
  },
};
---

<section id="contact" class="relative py-24 lg:py-32 bg-espresso-950 overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0 opacity-5" style="background-image: url('data:image/svg+xml,%3Csvg width=100 height=100 viewBox=%270 0 100 100%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cpath d=%27M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3z%27 fill=%27%23dd902c%27 fill-opacity=%271%27 fill-rule=%27evenodd%27/%3E%3C/svg%3E');"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="font-accent text-cafe-400 text-xl">Get in Touch</span>
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-white mt-2 mb-6">
        Find
        <span class="text-gradient">Us</span>
      </h2>
      <p class="max-w-xl mx-auto text-espresso-300 text-lg">
        We'd love to see you! Drop by, give us a ring, or find us on the map.
      </p>
      <div class="mt-6 flex items-center justify-center gap-2">
        <span class="w-12 h-[2px] bg-cafe-500/50 rounded-full"></span>
        <span class="w-2 h-2 bg-cafe-500 rounded-full"></span>
        <span class="w-12 h-[2px] bg-cafe-500/50 rounded-full"></span>
      </div>
    </div>

    <div class="grid lg:grid-cols-3 gap-8">
      <!-- Contact Cards -->
      <div class="space-y-6">
        <!-- Address -->
        <div class="card-hover p-6 rounded-2xl bg-white/5 backdrop-blur-sm border border-white/10 hover:border-cafe-500/30 transition-all duration-300">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-cafe-500/20 flex items-center justify-center">
              <svg class="w-6 h-6 text-cafe-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-white font-semibold mb-1">Address</h3>
              <p class="text-espresso-300 text-sm leading-relaxed">{contactInfo.address}</p>
            </div>
          </div>
        </div>

        <!-- Phone -->
        <a
          href={`tel:${contactInfo.phone.replace(/\s/g, '')}`}
          class="card-hover block p-6 rounded-2xl bg-white/5 backdrop-blur-sm border border-white/10 hover:border-cafe-500/30 transition-all duration-300"
        >
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-cafe-500/20 flex items-center justify-center">
              <svg class="w-6 h-6 text-cafe-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div>
              <h3 class="text-white font-semibold mb-1">Phone</h3>
              <p class="text-cafe-400 text-sm font-medium">{contactInfo.phone}</p>
              <p class="text-espresso-400 text-xs mt-1">Tap to call</p>
            </div>
          </div>
        </a>

        <!-- Hours -->
        <div class="card-hover p-6 rounded-2xl bg-white/5 backdrop-blur-sm border border-white/10 hover:border-cafe-500/30 transition-all duration-300">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-cafe-500/20 flex items-center justify-center">
              <svg class="w-6 h-6 text-cafe-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <div>
              <h3 class="text-white font-semibold mb-2">Opening Hours</h3>
              <div class="space-y-1">
                <div class="flex justify-between text-sm">
                  <span class="text-espresso-300">Sun – Thu</span>
                  <span class="text-white font-medium">{contactInfo.hours.weekdays}</span>
                </div>
                <div class="flex justify-between text-sm">
                  <span class="text-espresso-300">Fri – Sat</span>
                  <span class="text-white font-medium">{contactInfo.hours.weekends}</span>
                </div>
              </div>
              <div class="mt-3 flex items-center gap-2">
                <span class="relative flex h-2.5 w-2.5">
                  <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                  <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"></span>
                </span>
                <span class="text-green-400 text-xs font-medium">Open Now</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Google Rating Card -->
        <div class="card-hover p-6 rounded-2xl bg-gradient-to-br from-cafe-500/20 to-cafe-600/10 backdrop-blur-sm border border-cafe-500/30 transition-all duration-300">
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-xl bg-cafe-500 flex items-center justify-center shadow-lg">
              <span class="text-2xl">⭐</span>
            </div>
            <div>
              <div class="flex items-baseline gap-2">
                <span class="text-3xl font-display font-bold text-white">4.7</span>
                <span class="text-espresso-400 text-sm">/ 5.0</span>
              </div>
              <span class="text-espresso-300 text-xs">Rated on Google Reviews</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Map Embed -->
      <div class="lg:col-span-2">
        <div class="h-full min-h-[500px] rounded-3xl overflow-hidden border border-white/10 shadow-2xl">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3331.8!2d44.3661!3d33.3128!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMzPCsDE4JzQ2LjEiTiA0NMKwMjEnNTcuOSJF!5e0!3m2!1sen!2siq!4v1700000000000!5m2!1sen!2siq"
            width="100%"
            height="100%"
            style="border:0; min-height: 500px;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Twenty Eight Cafe28 location on Google Maps"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</section>