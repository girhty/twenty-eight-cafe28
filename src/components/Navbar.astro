---
const navLinks = [
  { label: 'Home', href: '#home' },
  { label: 'About', href: '#about' },
  { label: 'Gallery', href: '#gallery' },
  { label: 'Menu', href: '#menu' },
  { label: 'Reviews', href: '#reviews' },
  { label: 'Contact', href: '#contact' },
];
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-500 py-4"
  aria-label="Main navigation"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between">
      <!-- Logo -->
      <a href="#home" class="flex items-center gap-3 group" aria-label="Twenty Eight Cafe28 - Home">
        <div class="relative">
          <div class="w-12 h-12 rounded-full bg-espresso-950 flex items-center justify-center shadow-lg group-hover:shadow-cafe-500/30 transition-shadow duration-300">
            <span class="text-cafe-400 font-display font-bold text-lg">28</span>
          </div>
          <div class="absolute -top-1 -right-1 w-4 h-4 bg-cafe-500 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        </div>
        <div class="hidden sm:block">
          <span class="block text-sm font-display font-semibold tracking-wide text-white transition-colors duration-300 nav-text" style="text-shadow: 0 1px 3px rgba(0,0,0,0.5);">TWENTY EIGHT</span>
          <span class="block text-[10px] font-body uppercase tracking-[0.25em] text-cafe-300 nav-text" style="text-shadow: 0 1px 3px rgba(0,0,0,0.5);">Cafe28</span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <div class="hidden lg:flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="nav-link px-4 py-2 text-sm font-medium text-white/80 hover:text-cafe-300 transition-all duration-300 rounded-full hover:bg-white/10"
            style="text-shadow: 0 1px 3px rgba(0,0,0,0.4);"
          >
            {link.label}
          </a>
        ))}
        <a
          href="#contact"
          class="ml-3 px-6 py-2.5 bg-cafe-500 text-white text-sm font-semibold rounded-full hover:bg-cafe-600 transition-all duration-300 shadow-lg hover:shadow-cafe-500/40 hover:scale-105 active:scale-95"
        >
          Visit Us
        </a>
      </div>

      <!-- Mobile Menu Toggle -->
      <button
        id="mobile-toggle"
        class="lg:hidden relative w-10 h-10 flex items-center justify-center rounded-full bg-white/10 backdrop-blur-sm border border-white/20"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <span class="hamburger-line w-5 h-0.5 bg-white rounded-full transition-all duration-300 absolute"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="lg:hidden fixed inset-0 bg-espresso-950/98 backdrop-blur-xl transform translate-x-full transition-transform duration-500 ease-out"
    role="dialog"
    aria-label="Mobile navigation"
  >
    <div class="flex flex-col items-center justify-center h-full gap-6">
      <button
        id="mobile-close"
        class="absolute top-6 right-6 w-10 h-10 flex items-center justify-center rounded-full bg-white/10 border border-white/20 text-white"
        aria-label="Close navigation menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
      {navLinks.map((link, i) => (
        <a
          href={link.href}
          class="mobile-nav-link text-2xl font-display font-semibold text-white/90 hover:text-cafe-400 transition-colors duration-300"
          style={`animation-delay: ${i * 0.1}s`}
        >
          {link.label}
        </a>
      ))}
      <a
        href="#contact"
        class="mt-4 px-8 py-3 bg-cafe-500 text-white font-semibold rounded-full hover:bg-cafe-600 transition-all duration-300 text-lg"
      >
        Visit Us
      </a>
    </div>
  </div>
</nav>

<script>
  const navbar = document.getElementById('navbar');
  const toggle = document.getElementById('mobile-toggle');
  const menu = document.getElementById('mobile-menu');
  const close = document.getElementById('mobile-close');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  // Scroll effect
  function handleScroll() {
    if (window.scrollY > 50) {
      navbar?.classList.add('glass', 'shadow-lg', 'py-2');
      navbar?.classList.remove('py-4');
    } else {
      navbar?.classList.remove('glass', 'shadow-lg', 'py-4');
      navbar?.classList.add('py-2');
    }
  }

  window.addEventListener('scroll', handleScroll, { passive: true });
  handleScroll();

  // Mobile menu
  toggle?.addEventListener('click', () => {
    menu?.classList.remove('translate-x-full');
    menu?.classList.add('translate-x-0');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  });

  function closeMenu() {
    menu?.classList.add('translate-x-full');
    menu?.classList.remove('translate-x-0');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }

  close?.addEventListener('click', closeMenu);
  mobileLinks.forEach(link => link.addEventListener('click', closeMenu));
</script>