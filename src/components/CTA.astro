---

<section class="relative py-24 lg:py-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="relative rounded-[2rem] overflow-hidden">
      <!-- Background -->
      <div class="absolute inset-0 bg-dark-gradient"></div>
      <div class="absolute inset-0 opacity-10" style="background-image: url('data:image/svg+xml,%3Csvg width=60 height=60 viewBox=%270 0 60 60%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cg fill=%27none%27 fill-rule=%27evenodd%27%3E%3Cg fill=%27%23dd902c%27 fill-opacity=%271%27%3E%3Cpath d=%27M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z%27/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>

      <!-- Content -->
      <div class="relative px-8 py-16 sm:px-16 sm:py-20 text-center">
        <span class="font-accent text-cafe-400 text-xl">Don't Miss Out</span>
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-white mt-4 mb-6 max-w-3xl mx-auto leading-tight">
          Your Perfect Cup Awaits. <br class="hidden sm:block" />
          <span class="text-gradient">Visit Us Today.</span>
        </h2>
        <p class="text-espresso-300 text-lg max-w-xl mx-auto mb-10 leading-relaxed">
          Open daily and ready to serve you the finest coffee experience in Baghdad. Whether it's your first time or your fiftieth — we can't wait to welcome you.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="tel:07717107107"
            class="group inline-flex items-center gap-3 px-8 py-4 bg-cafe-500 text-white font-semibold rounded-full hover:bg-cafe-600 transition-all duration-300 shadow-xl hover:shadow-cafe-500/40 hover:scale-105 active:scale-95 text-lg animate-pulse-glow"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Call Now: 0771 710 7107
          </a>
          <a
            href="https://www.google.com/maps"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-3 px-8 py-4 bg-white/10 backdrop-blur-sm border border-white/30 text-white font-semibold rounded-full hover:bg-white/20 transition-all duration-300 hover:scale-105 active:scale-95 text-lg"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Get Directions
          </a>
        </div>

        <!-- Urgency badge -->
        <div class="mt-8 inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-cafe-500/10 border border-cafe-500/30">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"></span>
          </span>
          <span class="text-cafe-300 text-sm font-medium">We're Open Now — Come Visit!</span>
        </div>
      </div>
    </div>
  </div>
</section>