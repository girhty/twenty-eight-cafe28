---
const features = [
  {
    icon: '🫘',
    title: 'Handpicked Beans',
    description: 'We source the finest single-origin beans from Ethiopia, Colombia, and beyond — roasted in-house for peak flavor.',
  },
  {
    icon: '👨‍🍳',
    title: 'Expert Baristas',
    description: 'Our skilled baristas are true coffee artisans, crafting every drink with precision, passion, and flair.',
  },
  {
    icon: '🏡',
    title: 'Cozy Atmosphere',
    description: 'A warm, inviting space designed for connection — perfect for meetings, dates, or solo escapes with a book.',
  },
  {
    icon: '🌱',
    title: 'Fresh Ingredients',
    description: 'From our signature pastries to gourmet bites, everything is made fresh daily with locally-sourced ingredients.',
  },
];
---

<section id="about" class="relative py-24 lg:py-32 overflow-hidden">
  <!-- Background decoration -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-cafe-200/30 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
  <div class="absolute bottom-0 left-0 w-72 h-72 bg-cafe-300/20 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <!-- Section Header -->
    <div class="text-center mb-20">
      <span class="inline-block font-accent text-cafe-500 text-xl mb-3">Our Story</span>
      <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-espresso-950 mb-6">
        More Than Just
        <span class="text-gradient">Coffee</span>
      </h2>
      <p class="max-w-2xl mx-auto text-espresso-600 text-lg leading-relaxed">
        Twenty Eight Cafe28 was born from a simple belief: that a great cup of coffee has the power to transform your entire day. We're here to make every moment a little more extraordinary.
      </p>
      <div class="mt-6 flex items-center justify-center gap-2">
        <span class="w-12 h-[2px] bg-cafe-400 rounded-full"></span>
        <span class="w-2 h-2 bg-cafe-500 rounded-full"></span>
        <span class="w-12 h-[2px] bg-cafe-400 rounded-full"></span>
      </div>
    </div>

    <!-- Features Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {features.map((feature, i) => (
        <div class={`card-hover group relative p-8 rounded-3xl bg-white border border-cafe-100/80 shadow-sm hover:border-cafe-300 reveal reveal-delay-${i + 1}`}>
          <div class="text-4xl mb-5 group-hover:scale-110 transition-transform duration-300">{feature.icon}</div>
          <h3 class="font-display text-xl font-semibold text-espresso-900 mb-3">{feature.title}</h3>
          <p class="text-espresso-500 text-sm leading-relaxed">{feature.description}</p>
          <div class="absolute top-0 right-0 w-20 h-20 bg-cafe-50 rounded-bl-3xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        </div>
      ))}
    </div>

    <!-- Story Highlight -->
    <div class="mt-20 grid lg:grid-cols-2 gap-12 items-center">
      <div class="relative">
        <div class="aspect-[4/3] rounded-3xl overflow-hidden shadow-2xl">
          <img
            src="https://lh3.googleusercontent.com/gps-cs-s/AHRPTWmClIr55prprVaAR6lrKrdhbiZCEcSdLFqtCgrZl51jgbFIUADD_03zazSeNoFg6Ag1SJcCPGBl4epeDQJPYP-gdH9s71pP8G3u_WBmHnOB4kT_0BSsH94r6ekBw3-WEIWbJ3pn=w360-h480-k-no"
            alt="Twenty Eight Cafe28 interior"
            class="w-full h-full object-cover hover:scale-105 transition-transform duration-700"
            loading="lazy"
          />
        </div>
        <!-- Floating badge -->
        <div class="absolute -bottom-6 -right-6 sm:right-6 glass rounded-2xl p-5 shadow-xl animate-float">
          <div class="flex items-center gap-3">
            <div class="w-14 h-14 rounded-full bg-cafe-500 flex items-center justify-center">
              <span class="text-2xl">⭐</span>
            </div>
            <div>
              <span class="block text-2xl font-display font-bold text-espresso-900">4.7</span>
              <span class="block text-xs text-espresso-500">Google Rating</span>
            </div>
          </div>
        </div>
      </div>
      <div class="lg:pl-8">
        <span class="font-accent text-cafe-500 text-xl">Why Us?</span>
        <h3 class="font-display text-3xl sm:text-4xl font-bold text-espresso-950 mt-2 mb-6">
          Crafted with Passion,<br />Served with Love
        </h3>
        <div class="space-y-5">
          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-cafe-100 flex items-center justify-center mt-1">
              <svg class="w-5 h-5 text-cafe-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-espresso-800 mb-1">Quality Above All</h4>
              <p class="text-espresso-500 text-sm leading-relaxed">Every bean is carefully selected and roasted to perfection, ensuring each sip is an experience worth savoring.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-cafe-100 flex items-center justify-center mt-1">
              <svg class="w-5 h-5 text-cafe-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-espresso-800 mb-1">Community First</h4>
              <p class="text-espresso-500 text-sm leading-relaxed">We're not just a café — we're a gathering place where friends become family and conversations flow freely.</p>
            </div>
          </div>
          <div class="flex gap-4 items-start">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-cafe-100 flex items-center justify-center mt-1">
              <svg class="w-5 h-5 text-cafe-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div>
              <h4 class="font-semibold text-espresso-800 mb-1">Consistent Excellence</h4>
              <p class="text-espresso-500 text-sm leading-relaxed">Whether it's your first visit or your hundredth, we deliver the same exceptional experience every single time.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>